<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_food_detail.xml — Layout for the food detail screen.

    Uses a ScrollView so content scrolls if it's taller than the screen.
    Inside, a MaterialCardView holds the food icon and all text details,
    keeping the Material Design look consistent with the list.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hero card with the food icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_background"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Large food icon -->
                <ImageView
                    android:id="@+id/detailFoodIcon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@string/food_icon_desc"
                    android:scaleType="centerInside"
                    tools:src="@drawable/ic_food_pizza" />

                <!-- Food name -->
                <TextView
                    android:id="@+id/detailFoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:text="Margherita Pizza" />

                <!-- Category badge -->
                <TextView
                    android:id="@+id/detailFoodCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_category_badge"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    tools:text="Main Course" />

                <!-- Price -->
                <TextView
                    android:id="@+id/detailFoodPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/price_color"
                    tools:text="$12.99" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Description section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_description"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/detailFoodDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp"
            tools:text="A delicious dish..." />

        <!-- Ingredients section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_ingredients"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <TextView
                android:id="@+id/detailFoodIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                tools:text="• Tomato\n• Cheese\n• Basil" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
